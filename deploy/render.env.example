# Environment variables for the n8n web service on Render.
# Paste into Render → your service → Environment → "Add from .env", then fill in the <...> values.
# Never commit real values.

# --- n8n's own database: Supabase, session pooler (IPv4), port 5432 ---
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=<aws-0-REGION.pooler.supabase.com>
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=postgres
DB_POSTGRESDB_USER=postgres.<PROJECT_REF>
DB_POSTGRESDB_PASSWORD=<SUPABASE_DB_PASSWORD>
DB_POSTGRESDB_SCHEMA=n8n
DB_POSTGRESDB_SSL_ENABLED=true
DB_POSTGRESDB_SSL_REJECT_UNAUTHORIZED=false

# --- Public address (use your custom domain if you have one) ---
N8N_HOST=<your-domain.example.com>
N8N_PROTOCOL=https
N8N_PORT=5678
PORT=5678
WEBHOOK_URL=https://<your-domain.example.com>/

# --- Security and housekeeping ---
# Long random string. Keep a copy in a password manager: losing it makes stored credentials unreadable.
N8N_ENCRYPTION_KEY=<LONG_RANDOM_STRING>
GENERIC_TIMEZONE=Pacific/Auckland
TZ=Pacific/Auckland
# Delete run history older than 7 days to stay within Supabase's free storage
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168
