# Run n8n on your own machine against the same Supabase database as the deployed instance.
# Used for first-time setup (owner account, credentials) and for Gmail re-authorisation.
# Copy to deploy/local.env (git-ignored) and fill in the same values as on Render, except the address lines.
#
#   docker run --rm -it -p 5678:5678 --env-file deploy/local.env n8nio/n8n:<VERSION>
#
# Never run this and the deployed instance at the same time.

DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=<aws-0-REGION.pooler.supabase.com>
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=postgres
DB_POSTGRESDB_USER=postgres.<PROJECT_REF>
DB_POSTGRESDB_PASSWORD=<SUPABASE_DB_PASSWORD>
DB_POSTGRESDB_SCHEMA=n8n
DB_POSTGRESDB_SSL_ENABLED=true
DB_POSTGRESDB_SSL_REJECT_UNAUTHORIZED=false

# Must be EXACTLY the same key as on Render, or the stored credentials can't be decrypted
N8N_ENCRYPTION_KEY=<SAME_KEY_AS_RENDER>

N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Pacific/Auckland
TZ=Pacific/Auckland
